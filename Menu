    {Name="Highlight Team",Function=function(v) Config.HighlightTeam=v end},
    {Name="Hitbox Toggle",Function=function(v) Config.Hitbox=v end},
    {Name="Outline Toggle",Function=function(v) Config.Outline=v end},
    {Name="Head Dot",Function=function(v) Config.HeadDot=v end},
    {Name="Tracer Lines",Function=function(v) Config.Tracer=v end},
    {Name="ESP Refresh",Function=function() ESPUpdate() end},
}

local function ESPUpdate()
    for i,v in pairs(Players:GetPlayers()) do
        if v~=LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            local root=v.Character.HumanoidRootPart
            if Config.ESPEnabled then
                if not root:FindFirstChild("ESPBox") then
                    local box=Instance.new("BillboardGui",root)
                    box.Name="ESPBox"
                    box.Size=UDim2.new(2,0,3,0)
                    box.Adornee=root
                    box.AlwaysOnTop=true
                    local text=Instance.new("TextLabel",box)
                    text.Size=UDim2.new(1,0,1,0)
                    text.BackgroundTransparency=1
                    text.TextColor3=Color3.new(1,0,0)
                    text.TextStrokeTransparency=0.5
                    text.Text=Config.ShowName and v.Name or ""
                end
            else
                if root:FindFirstChild("ESPBox") then root.ESPBox:Destroy() end
            end
        end
    end
end

for i,feat in pairs(ESPFeatures) do
